@@ -0,0 +1,79 @@
+package expo.modules.notifications.fcmstub;
+
+import android.net.Uri;
+import android.os.Bundle;
+import android.os.Parcel;
+import android.os.Parcelable;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import java.util.Collections;
+import java.util.Map;
+
+/**
+ * FossFitness: stand-in for Firebase's RemoteMessage so expo-notifications builds without
+ * Google's proprietary Firebase Cloud Messaging library. Remote push is not used by the app;
+ * nothing ever creates one of these, they only keep the remote-push code paths compiling.
+ */
+public class RemoteMessage implements Parcelable {
+  public static final int PRIORITY_UNKNOWN = 0;
+  public static final int PRIORITY_HIGH = 1;
+  public static final int PRIORITY_NORMAL = 2;
+
+  private final Bundle bundle;
+
+  public RemoteMessage(@NonNull Bundle bundle) {
+    this.bundle = bundle;
+  }
+
+  @NonNull public Map<String, String> getData() { return Collections.emptyMap(); }
+  @Nullable public Notification getNotification() { return null; }
+  @Nullable public String getMessageId() { return null; }
+  public long getSentTime() { return 0; }
+  public int getTtl() { return 0; }
+  @Nullable public String getFrom() { return null; }
+  @Nullable public String getTo() { return null; }
+  @Nullable public String getSenderId() { return null; }
+  public int getPriority() { return PRIORITY_UNKNOWN; }
+  public int getOriginalPriority() { return PRIORITY_UNKNOWN; }
+  @Nullable public String getCollapseKey() { return null; }
+  @Nullable public String getMessageType() { return null; }
+
+  @Override public int describeContents() { return 0; }
+  @Override public void writeToParcel(@NonNull Parcel dest, int flags) { dest.writeBundle(bundle); }
+
+  public static final Creator<RemoteMessage> CREATOR = new Creator<RemoteMessage>() {
+    @Override public RemoteMessage createFromParcel(Parcel in) { return new RemoteMessage(in.readBundle(RemoteMessage.class.getClassLoader())); }
+    @Override public RemoteMessage[] newArray(int size) { return new RemoteMessage[size]; }
+  };
+
+  public static class Notification {
+    @Nullable public String getTitle() { return null; }
+    @Nullable public String getTitleLocalizationKey() { return null; }
+    @Nullable public String[] getTitleLocalizationArgs() { return null; }
+    @Nullable public String getBody() { return null; }
+    @Nullable public String getBodyLocalizationKey() { return null; }
+    @Nullable public String[] getBodyLocalizationArgs() { return null; }
+    @Nullable public String getIcon() { return null; }
+    @Nullable public Uri getImageUrl() { return null; }
+    @Nullable public String getSound() { return null; }
+    @Nullable public String getTag() { return null; }
+    @Nullable public String getColor() { return null; }
+    @Nullable public String getClickAction() { return null; }
+    @Nullable public String getChannelId() { return null; }
+    @Nullable public Uri getLink() { return null; }
+    @Nullable public String getTicker() { return null; }
+    public boolean getSticky() { return false; }
+    public boolean getLocalOnly() { return false; }
+    public boolean getDefaultSound() { return false; }
+    public boolean getDefaultVibrateSettings() { return false; }
+    public boolean getDefaultLightSettings() { return false; }
+    @Nullable public Integer getNotificationPriority() { return null; }
+    @Nullable public Integer getVisibility() { return null; }
+    @Nullable public Integer getNotificationCount() { return null; }
+    @Nullable public Long getEventTime() { return null; }
+    @Nullable public int[] getLightSettings() { return null; }
+    @Nullable public long[] getVibrateTimings() { return null; }
+  }
+}
