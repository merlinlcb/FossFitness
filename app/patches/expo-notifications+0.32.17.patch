+import android.app.Service;
+import android.content.Intent;
+import android.os.IBinder;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+/**
+ * FossFitness: stand-in for Firebase's FirebaseMessagingService (see RemoteMessage). The service
+ * is not declared in the manifest, so Android never starts it.
+ */
+public abstract class FirebaseMessagingService extends Service {
+  @Nullable @Override public IBinder onBind(Intent intent) { return null; }
+  public void onMessageReceived(@NonNull RemoteMessage message) {}
+  public void onNewToken(@NonNull String token) {}
+  public void onDeletedMessages() {}
+}
